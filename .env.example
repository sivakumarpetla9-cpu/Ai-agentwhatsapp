# Application Configuration
PROJECT_NAME="WhatsApp Dine-In Ordering API"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change_this_to_a_secure_secret_key_in_production

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=restaurant_ordering

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=True

# WhatsApp Cloud API Configuration
# Mode: 'mock' for local development/testing; 'meta' for live Meta Cloud API
WHATSAPP_MODE=mock
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_permanent_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_for_webhook_signature_verification
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verification_token_here
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_SIGNATURE=True
WHATSAPP_REQUEST_TIMEOUT=10.0

# Optional Billing & Multi-Tenant Overrides
BILL_TAX_RATE=0.05
DEFAULT_RESTAURANT_ID=

# CORS Configuration (JSON array format)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Logging Configuration
LOG_LEVEL=INFO
